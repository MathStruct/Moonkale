# Generated by Cargo
# will have compiled files and executables
/target
# A crate-local target/ (a relative CARGO_TARGET_DIR resolved from a crate
# directory put 15 GB under packages/web/target once — Milestone 18).
packages/**/target/
.DS_Store

# These are backup files generated by rustfmt
**/*.rs.bk

# Python test runner caches
__pycache__/
*.py[cod]

# Quartz site (site/ is vendored; these are build artefacts)
site/node_modules/
site/public/
site/quartz/.quartz-cache/
site/tsconfig.tsbuildinfo
# site/.tikz-cache is deliberately tracked: it keeps CI from recompiling diagrams

# Obsidian per-user state (the vault root is the repo root)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# JS interop packages
packages/js/*/node_modules

# local secrets (API keys); see markdown/Development.md
.secrets/

# Release artefacts and makepkg work dirs (Milestone 13)
/dist/
/packaging/arch/src/
/packaging/arch/pkg/
/packaging/arch/*.pkg.tar.*
/packaging/arch-bin/src/
/packaging/arch-bin/pkg/
/packaging/arch-bin/*.pkg.tar.*
/packaging/arch-bin/*.tar.gz
/packaging/arch/Moonkale/

# Android signing keys must never be committed (P-131).
*.jks
*.keystore

# Moonkale's own per-folder state (Milestone 18, phase 0): the entity log,
# layout, agent sessions and trash change on every session and must not be
# committed. Kept: what a folder deliberately shares (KaTeX macros, its own
# wasm extensions) — see markdown/architecture/Internal State.md.
.moonkale/*
!.moonkale/katex.json
!.moonkale/extensions/
