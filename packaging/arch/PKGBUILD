# Maintainer: Daniel Boigk <daniel@mathstruct.org>
#
# Builds Moonkale's desktop app from a git checkout with the Dioxus CLI.
# Layout: dx 0.7.10 writes the app to target/dx/moonkale/release/linux/app
# ({moonkale,assets/} — "moonkale" is the [application] name in Dioxus.toml)
# and the server to target/dx/web/release/web/server (Milestone 13). See
# markdown/packaging/Arch Linux.md. For friends who just want to install,
# packaging/arch-bin/PKGBUILD takes a release tarball instead.
#
# Local test without pushing: MOONKALE_GIT_URL="file://$PWD/../.." makepkg -s

pkgname=moonkale-git
pkgver=0.1.0.r55.g1eda12a
pkgrel=1
pkgdesc="Graph-native code and knowledge editor (git)"
arch=('x86_64' 'aarch64')
url="https://github.com/MathStruct/Moonkale"
license=('MIT')
# Runtime: what the binary links (see the -l flags in a failed link log).
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'xdotool' 'openssl' 'gcc-libs' 'glibc')
# Build: dioxus-cli is in the AUR (dioxus-cli or dioxus-cli-bin); it must be
# >= 0.7.10 to match the workspace's dioxus version.
makedepends=('git' 'cargo' 'rust' 'dioxus-cli' 'pkgconf')
provides=('moonkale' 'moonkale-server')
conflicts=('moonkale' 'moonkale-bin')
# !lto: makepkg's -flto in CFLAGS turns the C++ objects (DuckDB, ring) into GCC
# bitcode that rust-lld cannot link (undefined duckdb_*, ring_core_* — P-111).
options=('!debug' '!lto')
source=("Moonkale::git+${MOONKALE_GIT_URL:-https://github.com/MathStruct/Moonkale.git}")
sha256sums=('SKIP')

pkgver() {
  cd Moonkale
  printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd Moonkale
  # Fetch everything now so build() can run offline (makepkg policy).
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd Moonkale
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_NET_OFFLINE=true
  export CARGO_TARGET_DIR="$srcdir/Moonkale/target"
  # dx (not plain cargo): it collects the hashed `asset!()` files next to the
  # binary. The desktop app, then the server it uploads to remote hosts.
  (cd packages/desktop && dx build --release --platform desktop --features desktop)
  (cd packages/web && dx build --release --platform server)
}

package() {
  cd Moonkale
  local app="target/dx/moonkale/release/linux/app"
  # Layout the binary's asset resolver expects: bin/<exe> + lib/<ProductName>/assets.
  # ProductName is the PascalCase binary name dx bakes in (DIOXUS_PRODUCT_NAME).
  install -Dm755 "$app/moonkale" "$pkgdir/usr/bin/moonkale"
  install -Dm755 "target/dx/web/release/web/server" "$pkgdir/usr/bin/moonkale-server"
  install -d "$pkgdir/usr/lib/Moonkale"
  cp -r "$app/assets" "$pkgdir/usr/lib/Moonkale/assets"
  install -Dm644 packaging/linux/moonkale.desktop "$pkgdir/usr/share/applications/moonkale.desktop"
  install -Dm644 packages/desktop/assets/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/moonkale.png"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
