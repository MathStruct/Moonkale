{
  "name": "@moonkale/codemirror",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Thin CodeMirror 6 wrapper for Moonkale's code editor. Builds into packages/editors/code/assets/codemirror.js.",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=iife --minify --target=es2020 --outfile=../../editors/code/assets/codemirror.js",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.0",
    "@codemirror/view": "^6.36.0",
    "cm6-graphql": "^0.2.2",
    "codemirror-lang-typst": "^0.6.0"
  }
}
