extension-name = Flow-Editor
extension-description = Bausteine per Drag-and-drop, verbunden über typisierte Ports (*.flow.json). Bausteinbibliotheken kommen von anderen Erweiterungen.
flow-generated = { $file } erzeugt – ausführen: { $run }
flow-unsaved = Ungespeicherte Änderungen
flow-counts = { $blocks } Bausteine · { $wires } Verbindungen
flow-issues =
     · { $n ->
        [one] { $n } Problem
       *[other] { $n } Probleme
    }
flow-generate-title = Die { $language }-Datei neben diesen Flow schreiben
flow-generate = { $language } erzeugen
flow-layout = Anordnen
flow-fit = Einpassen
flow-save = Speichern
flow-no-libraries = Keine Bausteinbibliothek ist eingeschaltet. Schalte eine unter Einstellungen → Erweiterungen ein (z. B. Lux.jl).
flow-broken = Diese Datei ist kein gültiger Flow ({ $error }). Es wird nichts hineingeschrieben; korrigiere sie in einem Texteditor und drücke dann Neu laden.
flow-reload = Neu laden
flow-reload-title = Änderungen verwerfen und aus der Datei neu laden
