extension-name = Flow-Editor
extension-description = Bausteine per Drag-and-drop, verbunden über typisierte Ports (*.flow.json). Bausteinbibliotheken kommen von anderen Erweiterungen.
flow-generated = { $file } erzeugt – ausführen: { $run }
